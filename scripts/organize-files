#!/bin/zsh
set -euo pipefail

# Defaults
MAX_FILES=100
TARGET_DIR="."
COLOR=true

# Parse args
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      cat << 'EOF'
Usage: organize-files [directory] [options]

Move all regular files (non-hidden) into date-based subdirectories.
Each subdirectory holds at most 100 files by default.

Options:
  --max-files N   Max files per subdirectory (default: 100)
  --no-color      Disable colored output
  -h, --help      Show this help

Examples:
  organize-files ~/Downloads
  organize-files . --max-files 50
EOF
      exit 0
      ;;
    --max-files)
      MAX_FILES="$2"; shift 2
      ;;
    --no-color)
      COLOR=false; shift
      ;;
    -*)
      echo "Unknown option: $1" >&2; exit 1
      ;;
    *)
      TARGET_DIR="$1"; shift
      ;;
  esac
done

# Colors
if $COLOR; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
else
  GREEN=''; YELLOW=''; BLUE=''; NC=''
fi

# Validate target
if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: '$TARGET_DIR' is not a directory" >&2
  exit 1
fi
cd "$TARGET_DIR"

SCRIPT_NAME="$(basename "$0")"
TODAY="$(date +%y%m%d)"

# Collect regular files: non-hidden, non-dir, not self
files=()
for f in *(.N); do
  [[ "$f" == "$SCRIPT_NAME" ]] && continue
  files+=("$f")
done

total=${#files}

if (( total == 0 )); then
  echo "Nothing to do — no files to organize."
  exit 0
fi

# Header
echo "${BLUE}Target:${NC}  $(pwd)"
echo "${BLUE}Files:${NC}   ${total} (max ${MAX_FILES} per subdir)"
echo "${BLUE}Prefix:${NC}  ${TODAY}"
echo "${BLUE}$(printf '─%.0s' {1..40})${NC}"

# Find next available subdir slot for today's prefix
find_target_dir() {
  local prefix="$1"
  local seq=""

  while true; do
    local dir="${prefix}${seq}"
    if [[ -d "$dir" ]]; then
      local count=$(find "$dir" -maxdepth 1 -type f | wc -l | tr -d ' ')
      if (( count < MAX_FILES )); then
        echo "$dir"
        return
      fi
    else
      mkdir "$dir"
      echo "$dir"
      return
    fi
    # Next sequence
    if [[ -z "$seq" ]]; then
      seq="-01"
    else
      seq=$(printf "-%02d" $(( 10#${seq#-} + 1 )))
    fi
  done
}

declare -A moved
n=0
pad=${#total}

for f in "${files[@]}"; do
  dir=$(find_target_dir "$TODAY")
  mv -- "$f" "$dir/"
  moved[$dir]=$(( ${moved[$dir]:-0} + 1 ))
  printf "  ${YELLOW}[%${pad}d/${total}]${NC} %s ${BLUE}→${NC} %s/\n" "$(( ++n ))" "$f" "$dir"
done

# Summary
echo "${BLUE}$(printf '─%.0s' {1..40})${NC}"
echo "${GREEN}Done — ${total} file(s) organized${NC}"
for dir in ${(ko)moved}; do
  printf "  ${BLUE}%-14s${NC} ${YELLOW}%3d${NC} files\n" "$dir/" "${moved[$dir]}"
done
