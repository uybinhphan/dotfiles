#!/bin/zsh
set -euo pipefail

MAX_FILES=100
TARGET_DIR="."
COLOR=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      cat << 'EOF'
Usage: organize-files [directory] [options]

Move all regular files (non-hidden) into date-based subdirectories.
Each subdirectory holds at most 100 files by default.

Options:
  --max-files N   Max files per subdirectory (default: 100)
  --no-color      Disable colored output
  -h, --help      Show this help

Examples:
  organize-files ~/Downloads
  organize-files . --max-files 50
EOF
      exit 0 ;;
    --max-files) MAX_FILES="$2"; shift 2 ;;
    --no-color)  COLOR=false; shift ;;
    -*)          echo "Unknown option: $1" >&2; exit 1 ;;
    *)           TARGET_DIR="$1"; shift ;;
  esac
done

# Colors
if $COLOR; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
else
  GREEN=''; YELLOW=''; BLUE=''; NC=''
fi

[[ -d "$TARGET_DIR" ]] || { echo "Error: '$TARGET_DIR' is not a directory" >&2; exit 1; }
cd "$TARGET_DIR"

PREFIX="$(date +%y%m%d)"
SCRIPT_NAME="${0##*/}"

# Collect regular files: non-hidden, non-dir, exclude self
files=()
for f in *(.N); do
  [[ "$f" != "$SCRIPT_NAME" ]] && files+=("$f")
done

total=${#files}
(( total == 0 )) && { echo "Nothing to do — no files to organize."; exit 0; }

echo "${BLUE}Target:${NC}  $(pwd)"
echo "${BLUE}Files:${NC}   ${total} (max ${MAX_FILES} per subdir)"
echo "${BLUE}Prefix:${NC}  ${PREFIX}"
echo "${BLUE}$(printf '─%.0s' {1..40})${NC}"

# Find or create next directory with capacity.
# Tries plain YYMMDD first, then YYMMDD-01, YYMMDD-02, ...
next_dir() {
  local dir

  # Try plain prefix first
  dir="$PREFIX"
  if [[ -d "$dir" ]]; then
    local count=$(set -- "$dir"/*(.N); echo $#)
    (( count < MAX_FILES )) && { echo "$dir"; return; }
  else
    mkdir "$dir"; echo "$dir"; return
  fi

  # Then numbered: -01, -02, ...
  local seq=1
  while true; do
    printf -v dir "%s-%02d" "$PREFIX" $seq
    if [[ -d "$dir" ]]; then
      local count=$(set -- "$dir"/*(.N); echo $#)
      (( count < MAX_FILES )) && { echo "$dir"; return; }
    else
      mkdir "$dir"; echo "$dir"; return
    fi
    (( seq++ ))
  done
}

# Move files
typeset -A moved
n=0 pad=${#total}

for f in "${files[@]}"; do
  dir=$(next_dir)
  mv -- "$f" "$dir/"
  moved[$dir]=$(( ${moved[$dir]:-0} + 1 ))
  printf "  ${YELLOW}[%${pad}d/${total}]${NC} %s ${BLUE}→${NC} %s/\n" "$(( ++n ))" "$f" "$dir"
done

# Renumbering: when plain YYMMDD coexists with numbered dirs, shift all up by 1.
# YYMMDD → YYMMDD-01, YYMMDD-01 → YYMMDD-02, ...
dated_dirs=(${PREFIX}*(N/))
if (( ${#dated_dirs} >= 2 )) && [[ -d "$PREFIX" ]]; then
  typeset -A rename_map
  for d in "${dated_dirs[@]}"; do
    if [[ "$d" == "$PREFIX" ]]; then
      rename_map[$d]="${PREFIX}-01"
    elif [[ "$d" =~ "^${PREFIX}-([0-9]{2})$" ]]; then
      rename_map[$d]=$(printf "%s-%02d" "$PREFIX" $(( 10#${match[1]} + 1 )))
    fi
  done

  # Rename descending so target never already exists
  for d in ${(On)${(k)rename_map}}; do
    [[ "$d" != "${rename_map[$d]}" ]] && mv -- "$d" "${rename_map[$d]}"
  done

  # Update moved keys
  typeset -A tmp
  for d in ${(k)moved}; do tmp[${rename_map[$d]:-$d}]=${moved[$d]}; done
  set -A moved
  for d in ${(k)tmp}; do moved[$d]=${tmp[$d]}; done
fi

# Summary
echo "${BLUE}$(printf '─%.0s' {1..40})${NC}"
echo "${GREEN}Done — ${total} file(s) organized${NC}"
for dir in ${(ko)moved}; do
  printf "  ${BLUE}%-14s${NC} ${YELLOW}%3d${NC} files\n" "$dir/" "${moved[$dir]}"
done
