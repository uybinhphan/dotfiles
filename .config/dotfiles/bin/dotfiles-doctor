#!/usr/bin/env bash
# Read-only health check for the dotfiles setup: drift, missing wiring, leaks.
# Exits 1 if anything needs attention.

set -uo pipefail

dotfiles() { /usr/bin/git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"; }
problems=0
section() { printf '\n%s\n' "$1"; }
ok() { printf '  \033[0;32m✓\033[0m %s\n' "$1"; }
bad() { printf '  \033[0;31m✗\033[0m %s\n' "$1"; problems=$((problems + 1)); }
info() { printf '  \033[0;33m·\033[0m %s\n' "$1"; }

section "Repository"
if [ -z "$(dotfiles status --porcelain)" ]; then
    ok "no uncommitted changes"
else
    bad "uncommitted changes: $(dotfiles status --porcelain | awk '{print $2}' | paste -sd ' ' -)"
fi
# showUntrackedFiles=no hides new files, so look in the places that should be fully tracked.
untracked=$(cd "$HOME" && dotfiles ls-files --others --exclude-standard -- .zsh .config/dotfiles .claude/hooks .claude/agents)
if [ -z "$untracked" ]; then
    ok "nothing untracked in .zsh, .config/dotfiles, .claude/hooks, .claude/agents"
else
    bad "untracked: $(paste -sd ' ' - <<<"$untracked")"
fi
for dir in "$HOME"/.config/*/; do
    name=".config/$(basename "$dir")"
    [ -z "$(dotfiles ls-files -- "$HOME/$name")" ] && info "$name is not tracked"
done

section "Secrets"
if [ "$(dotfiles config --get core.hooksPath)" = "$HOME/.config/dotfiles/hooks" ]; then
    ok "pre-commit hook wired (core.hooksPath)"
else
    bad "core.hooksPath not set: dotfiles config core.hooksPath ~/.config/dotfiles/hooks"
fi
if ! command -v gitleaks >/dev/null 2>&1; then
    bad "gitleaks not installed"
elif gitleaks git --redact --no-banner --log-level=error "$HOME/.dotfiles" >/dev/null 2>&1; then
    ok "gitleaks: no leaks in history"
else
    bad "gitleaks found leaks: gitleaks git --redact -v ~/.dotfiles"
fi
[ -e "$HOME/.zsh_secrets" ] && bad "plaintext ~/.zsh_secrets is back; move keys to the Keychain"

section "Homebrew"
if brew bundle check --file="${HOMEBREW_BUNDLE_FILE:-$HOME/.config/dotfiles/Brewfile}" >/dev/null 2>&1; then
    ok "everything in the Brewfile is installed"
else
    bad "Brewfile entries missing or outdated: brew bundle install"
fi
if "$HOME/.config/dotfiles/bin/brewfile-sync" --check >/dev/null 2>&1; then
    ok "nothing installed outside the Brewfile"
else
    bad "installed packages not in the Brewfile: brewfile-sync"
fi

section "Shell"
if zsh -n "$HOME/.zshrc" && (for f in "$HOME"/.zsh/plugins/*.zsh; do zsh -n "$f" || exit 1; done); then
    ok "zsh config parses"
else
    bad "zsh syntax error (see above)"
fi

echo
[ "$problems" -eq 0 ] && echo "All good." || echo "$problems problem(s) found."
[ "$problems" -eq 0 ]
