[user]
	name = Uy Binh
	email = uybinh@gmail.com
[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true

[alias]
	au = add -u							# Add updated files to staging
	s = status -sb                      # Concise status output
	co = checkout						# Checkout a branch			
	cob = checkout -b                   # Checkout with branch creation
	cp = cherry-pick					# Cherry-pick a commit	
	cm = commit -m                      # Commit with message
	ca = commit --amend                 # Amend previous commit
	amend = commit --amend --no-edit    # Amend without changing message
	unstage = reset HEAD --             # Unstage files
	undo = reset --soft HEAD^           # Undo last commit, keep changes
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit # Pretty log output
	recent = for-each-ref --sort=-committerdate --count=10 --format='%(refname:short)' refs/heads/ # Show recent branches

[push]
	default = current					# Push current branch to its upstream branch
	autoSetupRemote = true				# Automatically set the upstream when pushing a new branch

[diff]
	algorithm = histogram		# Use histogram diff algorithm for better performance on large files
	colorMoved = default		# Show moved lines as separate blocks instead of delete/add
