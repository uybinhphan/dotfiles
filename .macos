#!/usr/bin/env bash

# macOS Configuration Script
# This script applies common macOS settings to enhance usability and productivity.
# Usage: Source this script in your terminal or include it in your setup process.

# Set Dock size and magnification
defaults write com.apple.dock tilesize -int 40 # Set Dock icon size to 40 pixels
# defaults write com.apple.dock magnification -bool true  # Enable magnification
# defaults write com.apple.dock largesize -int 56 # Set magnified icon size to 56 pixels

# Move Dock to the right side of the screen
defaults write com.apple.dock orientation -string "bottom"  # Set Dock position to bottom

# Set bottom-left hotcorner to Mission Control 
defaults write com.apple.dock wvous-bl-corner -int 2  # Bottom-left corner for Mission Control
# Set bottom-right hotcorner to Application Windows
defaults write com.apple.dock wvous-br-corner -int 3  # Bottom-right corner for Application Windows

# Show status bar in Finder
defaults write com.apple.finder ShowStatusBar -bool true  # Show status bar
# Show path bar in Finder
defaults write com.apple.finder ShowPathbar -bool true  # Show path bar

# Set shutdown shortcut "Shut Down…" to Cmd+Option+S
defaults write -g NSUserKeyEquivalents -dict-add "Shut Down…" "@~S"
# Set restart shortcut "Restart…" to Cmd+Option+R
defaults write -g NSUserKeyEquivalents -dict-add "Restart…" "@~R"

# Restart affected applications
killall Dock
killall Finder

# Print completion message
echo "macOS settings have been applied. Some changes may require a logout/restart to take effect."
